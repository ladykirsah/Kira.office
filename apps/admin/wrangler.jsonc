{
  // Deploy config for the admin app (separate Worker from the api). OpenNext generates
  // .open-next/worker.js + assets; `opennextjs-cloudflare deploy` uses this.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiraoffice-admin",
  // GoGoCash — the SAME account as the api + storefront (and the homeseeker.me zone). The admin
  // used to live on the old "homeseeker" account (8724aa41…); that split is exactly what caused the
  // cross-account proxy 1003 failure the storefront config warns about. Consolidated here so the
  // admin→api proxy, the custom domain below, and Cloudflare Access all stay within one account.
  "account_id": "187ab61ed9dbc6e616cb23e6b95aa8f1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // PARKED (owner, 4 Nov 2026: "i want to swap for the old one … i am going to keep using the new
  // one"). The Expo app (apps/mobile, teampit-app) now serves admin.airplusauto.com; CI no longer
  // deploys this Worker, and admin.homeseeker.me was taken off with it. The Worker stays on the
  // account, with no address, for two weeks in case something was missed — then it is deleted.
  //
  // Both keys are load-bearing, like the staging note below says: a manual `npm run deploy` with the
  // old routes would pull admin.airplusauto.com back off the new app. Empty routes + no workers.dev
  // = a deploy reaches no one.
  //
  // If it ever goes back up: gate a hostname with Cloudflare Access BEFORE attaching it here, and ADD
  // Access destinations, never replace them (docs/KIRA_OFFICE_ACCESS_SETUP.md, 2026-07-21 incident).
  "routes": [],
  "workers_dev": false,
}
