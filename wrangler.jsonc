{
  // Live config for the api Worker (Cloudflare account "GoGoCash").
  // `name` MUST match the Worker created in the dashboard so deploys update it.
  // Deployed from repo root via `npx wrangler deploy` — run by the GitHub Actions `deploy` job
  // (.github/workflows) on push to main, once the CLOUDFLARE_API_TOKEN secret is set.
  // Bindings (D1, R2, KV, Queues, Durable Objects) are added as resources are provisioned —
  // see the full target config in docs/CLOUDFLARE_ARCHITECTURE.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  // MUST equal the live Worker's name. The live Worker on GoGoCash is `teampit-api`: created
  // 2026-06-23 as `kiraoffice`, renamed IN PLACE in the dashboard on 2026-11-18 (plan 9.2 part 4),
  // which kept its secrets, addresses, cron and the StockLedger namespace (proved first on two
  // throwaway Workers). A name the account does not have makes wrangler CREATE a second Worker,
  // whose `migrations` v1 then collides with the existing DO namespace — the 2026-07-20 deadlock:
  //   api:        "DO namespace name 'kira-office_StockLedger' already in use" [10065]
  //   storefront: "Cannot create binding for class in script '<name>' that does not exist" [10061]
  // To rename again: rename the Worker in the dashboard FIRST, then ship this name and AirPlus's
  // `script_name` to match (scripts/teampit-name.test.mjs checks they agree). The DO namespace's
  // display name still reads `kira-office_StockLedger`; that is cosmetic — the binding resolves by
  // (script_name, class_name).
  "name": "teampit-api",
  // Pin the GoGoCash account so `wrangler deploy` doesn't fail in CI when the token can see
  // multiple accounts ("unable to select one in non-interactive mode"). account_id is not a secret.
  // (Migrated from the old "homeseeker" account once homeseeker.me + the paid plan moved to GoGoCash.)
  "account_id": "187ab61ed9dbc6e616cb23e6b95aa8f1",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "STOCK_LEDGER", "class_name": "StockLedger" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StockLedger"] }],
  // Production says NO to the practice-copy door, out loud, rather than leaving it unset.
  // `POST /staff/login-practice` hands out a super-admin session with no credential; it is correct
  // on a throwaway local database and a catastrophe anywhere else. An absent variable means "nobody
  // happened to set it"; this says "this deployment refuses". `.dev.vars` overrides it to "1"
  // locally and is gitignored, so it never travels. A test over this file (practiceCopyGate.test.ts)
  // fails the build if any environment here stops saying it — including a newly added one.
  "vars": { "PRACTICE_COPY": "0" },
  "d1_databases": [
    {
      "binding": "DB",
      // Den Air's database: teampit-denair since 2026-11-18 (D1 can't rename — copied whole while the
      // shop was closed; kira-office kept two weeks, then deleted with the owner's yes).
      "database_name": "teampit-denair",
      "database_id": "e609101c-78d3-4a80-94a6-0cc5d4625d17",
      "migrations_dir": "packages/db/migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "a64f57510fcf491695b1170bf5057a6d" }],
  // teampit-images since 2026-11-18: R2 can't rename, so every object was copied to it under the same
  // key (D1 stores only keys). The old kiraoffice-images is kept two weeks, then deleted with the
  // owner's yes. Staging keeps its own bucket below.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "teampit-images" }],
  // Phase 6: provision a private bucket and add (uncomment after bucket exists in dashboard):
  // { "binding": "BACKUPS", "bucket_name": "kiraoffice-backups" },
  // Daily backup at 19:00 UTC (= 02:00 Asia/Bangkok). Shopee periodic sync hooks into the same
  // scheduled() handler once SHOPEE_* creds are set.
  "triggers": { "crons": ["0 19 * * *"] },
  // Phase 5 Shopee queue (uncomment after queue + dead-letter are provisioned):
  // "queues": {
  //   "producers": [{ "binding": "SHOPEE_QUEUE", "queue": "kira-shopee-sync" }],
  //   "consumers": [{ "queue": "kira-shopee-sync", "max_batch_size": 5, "max_retries": 3, "dead_letter_queue": "kira-shopee-sync-dlq" }]
  // },
  // Secrets (set via `wrangler secret put`, never vars): ACCESS_TEAM_DOMAIN, ACCESS_AUD, SLIPOK_API_KEY, SLIPOK_BRANCH_ID
  // Optional var: ALLOWED_CORS_ORIGINS (comma-separated; defaults include localhost:3000 + app.homeseeker.me)
  // SUPER_ADMIN_EMAILS (set via `wrangler secret put`; comma/space-separated): who may view payment-slip
  //   evidence via GET /file/slip/*. Unset + Access ON = nobody. Local dev (Access off) = everyone.
  //   Set this in prod or slips are viewable by no one. (Future: the `owner` role once a users table lands.)
  // Custom domain on the homeseeker.me zone (same Cloudflare account). wrangler deploy provisions
  // the DNS record + cert. Requires the deploy token (CLOUDFLARE_API_TOKEN) to have zone
  // DNS/Workers-routes edit.
  // BOTH hostnames during the move to a single domain. api.airplusauto.com is the destination;
  // api.homeseeker.me stays live until every caller has been switched over, so nothing goes dark
  // mid-migration. Remove the old one only after the admin and storefront are confirmed on the new.
  //
  // Safe to expose immediately: this Worker is gated by requireAccess in code (it verifies the
  // forwarded Access JWT), NOT by an edge Access application — so a new hostname does not create an
  // unprotected door the way it would for the admin.
  "routes": [
    { "pattern": "api.homeseeker.me", "custom_domain": true },
    { "pattern": "api.airplusauto.com", "custom_domain": true },
  ],
  // Queues + Cron are the next phase (Shopee sync) — see docs/CLOUDFLARE_ARCHITECTURE.md.
}
